rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user has the 'admin' role
    function isAdmin() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(userDoc) && get(userDoc).data.role == 'admin';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow any authenticated user to read and list user profiles.
      // This is necessary for shops to fetch the admin's UPI details.
      allow read, list: if request.auth != null;
      // Only the owner or an admin can write to a user document.
      allow write: if isAdmin() || isOwner(userId);
    }

    // Rules for the 'products' collection
    match /products/{productId} {
      allow read: if request.auth != null;
      // Allow write for admins, OR for any authenticated user (for stock updates during orders)
      allow write: if isAdmin() || request.auth != null;
    }

    // Rules for the 'orders' collection
    match /orders/{orderId} {
      // Allow read if admin or the order belongs to the user
      allow read: if isAdmin() || (request.auth != null && resource.data.shopId == request.auth.uid);

      // Allow create if the user is authenticated, creating their own order, and the timestamp is valid.
      allow create: if request.auth != null &&
                    request.resource.data.shopId == request.auth.uid &&
                    request.resource.data.status == "Pending" &&
                    request.resource.data.createdAt == request.time;

      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

    // Rules for 'laborers' and 'attendance' collections
    match /laborers/{laborerId} {
      allow read, write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAdmin();
    }

    // Rules for 'settings' collection
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Rules for 'visitors' collection (analytics)
    match /visitors/{visitorId} {
      // Anyone can create a visitor log (anonymous or logged in)
      allow create: if true;
      // Only admins can read the analytics logs
      allow read, update, delete: if isAdmin();
    }
  }
}
